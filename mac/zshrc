# completion based on pretext
bindkey "^[[A" history-beginning-search-backward
bindkey "^[[B" history-beginning-search-forward

export EDITOR=nvim
export VISUAL="$EDITOR"
alias v='nvim'

batdiff() {
    git diff --name-only --relative --diff-filter=d | xargs bat --diff
}

