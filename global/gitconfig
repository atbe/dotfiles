[mergetool]
    keepBackup = false

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    line-numbers = true
    navigate = true

[merge]
    conflictstyle = zdiff3

# pandoc diff support when requested
[diff "pandoc"]
    textconv=pandoc --to=markdown
    prompt = false
# wdiff = word diff
[alias]
    wdiff = diff --word-diff=color --unified=1
    st = status
    stm = status --untracked=no
    stfu = status --untracked=no
	lg = log --graph --pretty=format:'%Cred%h%C(yellow)%d %Cgreen%cr %Cblue%an%Creset %s' --date=relative --all
[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
	safecrlf = false
	editor = nano
[pager]
	branch = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Ibrahim Ahmed
	email = abeahmed2@gmail.com

[alias]
    dsf = diff --color
[pager]
    dsf = diff-so-fancy | less --tabs=4 -RFXS

[url "git@github.com:"]
	insteadOf = https://github.com/
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
