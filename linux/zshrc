# Set name of the theme to load.
# Look in ~/.oh-my-zsh/themes/
# Optionally, if you set this to "random", it'll load a random theme each
# time that oh-my-zsh is loaded.
ZSH_THEME="bureau"

export PATH="$HOME/bin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Autoload features ftw
autoload predict-on

if (( $+commands[antibody] )); then
    export ZSH="$(antibody home)/https-COLON--SLASH--SLASH-github.com-SLASH-robbyrussell-SLASH-oh-my-zsh"
    source <(antibody init)
    [[ -r "$HOME/.zsh_plugins" ]] && antibody bundle < "$HOME/.zsh_plugins"
fi

plugins=(kubectl history-substring-search autojump git)
if (( $+commands[kubectl] )); then
    source <(kubectl completion zsh)
fi

[[ -s "$HOME/.autojump/etc/profile.d/autojump.sh" ]] && source "$HOME/.autojump/etc/profile.d/autojump.sh"

# completion based on pretext
bindkey "^[[A" history-beginning-search-backward
bindkey "^[[B" history-beginning-search-forward

export EDITOR='nvim'
alias v='nvim'

#################################################
# Alias'
#################################################

alias gs="git status"
alias gd="git diff"
alias gpl="git pull origin"
alias gpo="git push origin"
alias gc="git checkout"
alias gm="git merge"
alias gcm="git commit -m "

alias ti="ls -latrTh"

alias k="kubectl"

alias codex-openai='codex -c model_provider="openai"'
alias codex-litellm='codex -c model_provider="litellm"'

alias claude-litellm='ANTHROPIC_BASE_URL=https://lllm.inference.net ANTHROPIC_API_KEY=$LITELLM_API_KEY claude'

#################################################
#
#################################################

# disable auto_pushd
unsetopt AUTO_PUSHD

# Add this to .bashrc or its equivalent
 transfer() { if [ $# -eq 0  ]; then echo "No arguments specified. Usage:\necho transfer /tmp/test.md\ncat /tmp/test.md | transfer test.md"; return 1; fi
 tmpfile=$( mktemp -t transferXXX  ); if tty -s; then basefile=$(basename "$1" | sed -e 's/[^a-zA-Z0-9._-]/-/g'); curl --progress-bar --upload-file "$1" "https://transfer.sh/$basefile" >> $tmpfile; else curl --progress-bar --upload-file "-" "https://transfer.sh/$1" >> $tmpfile ; fi; cat $tmpfile; rm -f $tmpfile;  }

[ -f "$HOME/.fzf.zsh" ] && source "$HOME/.fzf.zsh"

# base16 color
if [[ ! -d "$HOME/.config/base16-shell/.git" ]]; then
    git clone https://github.com/chriskempson/base16-shell.git "$HOME/.config/base16-shell" &> /dev/null
fi
BASE16_SHELL="$HOME/.config/base16-shell/"
[ -n "$PS1"  ] && [ -s "$BASE16_SHELL/profile_helper.sh"  ] && eval "$("$BASE16_SHELL/profile_helper.sh")"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# go
export PATH=$PATH:/usr/local/go/bin
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH"
export PATH="$PATH:$GOPATH/bin"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# asdf version manager
export PATH="$PATH:$HOME/.asdf/bin:$HOME/.asdf/shims"

# added by travis gem
[ -f "$HOME/.travis/travis.sh" ] && source "$HOME/.travis/travis.sh"
export PATH="/usr/local/opt/sphinx-doc/bin:$PATH"

export PATH="$PATH:$HOME/bin/google-cloud-sdk/bin"

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/bin/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/bin/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/bin/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/bin/google-cloud-sdk/completion.zsh.inc"; fi

export PATH="/usr/local/opt/helm@2/bin:$PATH"

alias apim="dotnet /mnt/c/Code/git/azure-api-management-devops-resource-kit/src/APIM_ARMTemplate/apimtemplate/bin/Debug/netcoreapp2.1/apimtemplate.dll"

if (( $+commands[scmpuff] )); then
    eval "$(scmpuff init -s)"
fi
# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
# CF CLI completions
[[ -f "$HOME/.config/cf/completions/_cf.zsh" ]] && source "$HOME/.config/cf/completions/_cf.zsh"

export PATH="$HOME/.kimi-code/bin:$PATH"

[[ -r "$HOME/.env" ]] && source "$HOME/.env"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=("$HOME/.grok/completions/zsh" $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<

# >>> railway initialize >>>
[[ -r "$HOME/.railway/env" ]] && source "$HOME/.railway/env"
# <<< railway initialize <<<

# Headless boxes: dummy DISPLAY so CLIs (Claude Code etc.) attempt xclip,
# which is shimmed in ~/.local/bin to proxy the Mac clipboard over Tailscale.
export DISPLAY=${DISPLAY:-:0}
