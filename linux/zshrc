# Set name of the theme to load.
# Look in ~/.oh-my-zsh/themes/
# Optionally, if you set this to "random", it'll load a random theme each
# time that oh-my-zsh is loaded.
ZSH_THEME="bureau"

export PATH="$HOME/bin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Autoload features ftw
autoload predict-on

if (( $+commands[antibody] )); then
    export ZSH="$(antibody home)/https-COLON--SLASH--SLASH-github.com-SLASH-robbyrussell-SLASH-oh-my-zsh"
    # oh-my-zsh plugins loaded via antibody (e.g. docker) cache completions here;
    # without it they tee to /completions/_docker and error on every shell start
    export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-$HOME/.cache/oh-my-zsh}"
    mkdir -p "$ZSH_CACHE_DIR/completions"
    source <(antibody init)
    [[ -r "$HOME/.zsh_plugins" ]] && antibody bundle < "$HOME/.zsh_plugins"
fi

plugins=(kubectl history-substring-search autojump git)
if (( $+commands[kubectl] )); then
    source <(kubectl completion zsh)
fi

[[ -s "$HOME/.autojump/etc/profile.d/autojump.sh" ]] && source "$HOME/.autojump/etc/profile.d/autojump.sh"

# completion based on pretext
bindkey "^[[A" history-beginning-search-backward
bindkey "^[[B" history-beginning-search-forward

